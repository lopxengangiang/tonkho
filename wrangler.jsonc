      "binding": "TONKHO",
      // Tạo namespace: Dashboard → Storage & Databases → KV → Create, rồi dán ID vào đây.
      "id": "65ddf57cec0c407fb7b191f343a1c540"
    }
  ],
  "observability": {
    "enabled": true
  }
}
